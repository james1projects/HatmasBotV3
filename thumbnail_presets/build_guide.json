{
  "schema_version": 1,
  "name": "build_guide",
  "description": "Build / guide thumbnail. God card fills the canvas top-anchored with the top 38% of the source kept (zooms in on the face for typical portrait-style cards); 3 item tiles (268px, colorable borders via role \"item_border\" + --item-border-color / the studio dropdown) sit centered in a row across the bottom. Headline defaults big (168px, override via --text-size / the studio field) and does NOT auto-fill with the god name (auto_headline false \u2014 the god-name layer already shows it). Per-god crop overrides live in data/god_card_crops.json for outliers like Ymir whose card has the face in an unusual location.",
  "size": [
    1280,
    720
  ],
  "layers": [
    {
      "type": "solid",
      "name": "Background",
      "color": "#0a0e14"
    },
    {
      "type": "image",
      "name": "Hero god card (top-anchored)",
      "src": "{my_god_card}",
      "pos": [
        0,
        0
      ],
      "size": [
        1280,
        720
      ],
      "fit": "cover",
      "fit_anchor": "top",
      "anchor": "topleft",
      "fallback_text": "{my_god}",
      "crop_source": {
        "top": 0.0,
        "bottom": 0.38
      }
    },
    {
      "type": "gradient",
      "name": "Bottom darkening band (gives items contrast)",
      "pos": [
        0,
        380
      ],
      "size": [
        1280,
        340
      ],
      "direction": "vertical",
      "stops": [
        {
          "at": 0.0,
          "color": "#000000",
          "opacity": 0.0
        },
        {
          "at": 0.6,
          "color": "#000000",
          "opacity": 0.55
        },
        {
          "at": 1.0,
          "color": "#000000",
          "opacity": 0.85
        }
      ]
    },
    {
      "type": "gradient",
      "name": "Top darkening band (legibility for headline + badges)",
      "pos": [
        0,
        0
      ],
      "size": [
        1280,
        220
      ],
      "direction": "vertical",
      "stops": [
        {
          "at": 0.0,
          "color": "#000000",
          "opacity": 0.75
        },
        {
          "at": 1.0,
          "color": "#000000",
          "opacity": 0.0
        }
      ]
    },
    {
      "type": "text",
      "name": "God name (top-left)",
